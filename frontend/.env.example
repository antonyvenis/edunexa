# Leave empty for demo mode (data stays in the visitor's browser, any role can be picked).
# Set to your backend to use real accounts, e.g. https://your-service.onrender.com/api
VITE_API_URL=
# Real mode hides the demo role buttons. Set to true only if you want them visible.
VITE_SHOW_DEMO_LOGINS=
# Optional, for the public recruiter preview page (/tour):
VITE_DEMO_URL=      # URL of your public demo site, used by the real app to link to the tour
VITE_GITHUB_URL=    # link to the source code repository
